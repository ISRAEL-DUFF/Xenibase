# TLS for the web UI (spec §3.2). Caddy obtains the UI certificate itself;
# xenibase-server obtains the DB hostname's certificate for the poolers, and
# Caddy forwards that hostname's HTTP-01 challenges to it.
{
	email {$XENIBASE_ACME_EMAIL}
	{$CADDY_GLOBAL_OPTIONS}
	# Global options of another app served by this Caddy (docs/cohosting.md),
	# e.g. caddy.d/taskiem.global with on_demand_tls. None by default.
	import /etc/caddy/caddy.d/*.global
}

{$XENIBASE_UI_DOMAIN} {
	{$CADDY_UI_TLS}
	encode zstd gzip
	reverse_proxy xenibase-server:8080
}

# More sites: backend services' wildcard API domain (api.caddy, written by
# enable-services.sh), and another app's sites when co-hosting (its own
# file). Nothing matches (and nothing is served) until then.
import /etc/caddy/caddy.d/*.caddy

# Any other host on port 80. Caddy answers the HTTP-01 challenges of the
# certificates it gets itself before any of this (on-demand ones included);
# the rest go to xenibase-server, which gets the DB hostname's certificate.
# Everything else is redirected (308): to the UI, or with co-hosting to HTTPS
# on the same name (CADDY_HTTP_REDIRECT, set in compose.yaml).
http:// {
	handle /.well-known/acme-challenge/* {
		reverse_proxy xenibase-server:8080
	}
	handle {
		redir {$CADDY_HTTP_REDIRECT} 308
	}
}
