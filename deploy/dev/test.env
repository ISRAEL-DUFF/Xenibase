# Environment for test/integration and test/isolation (see test/testenv),
# against `make dev-up` plus the test pooler pair (`--profile test`).
XENIBASE_TEST_DATABASE_URL=postgres://xenibase:xenibase@127.0.0.1:5440/xenibase?sslmode=disable
XENIBASE_TEST_SHARED_ADMIN_URL=postgres://xenibase_admin:xenibase_admin@127.0.0.1:5441/postgres?sslmode=disable
XENIBASE_TEST_SHARED_POOLER_HOST=shared-pg
XENIBASE_TEST_SHARED_POOLER_PORT=5432
XENIBASE_TEST_POOLER_DIR=tmp/pooler-test
XENIBASE_TEST_POOLER_SESSION_ADDR=127.0.0.1:6442
XENIBASE_TEST_POOLER_POOLED_ADDR=127.0.0.1:6553
XENIBASE_TEST_POOLER_ADMIN_PASSWORD=xenibase
# M3: the agent container, the address host-side test servers listen on
# (the Compose network's gateway), and the import sources.
XENIBASE_TEST_DOCKER_GATEWAY=172.31.251.1
XENIBASE_TEST_AGENT_CONTAINER=xenibase-dev-agent-test-1
XENIBASE_TEST_AGENT_ADDR=127.0.0.1:7071
XENIBASE_TEST_METADATA_AGENT_HOST=metadata-db:5432
XENIBASE_TEST_SRC_SUPABASE_URL=postgres://postgres:supabase-source@172.31.251.1:5450/postgres?sslmode=disable
XENIBASE_TEST_SRC_PG15_URL=postgres://postgres:pg15-source@172.31.251.1:5451/postgres?sslmode=disable
# M4: dedicated instances, run by the agent through the host's Docker.
XENIBASE_TEST_PG_IMAGE=xenibase-postgres:{major}-walg3.0.9
XENIBASE_TEST_DOCKER_NETWORK=xenibase-dev_default
XENIBASE_TEST_AGENT2_CONTAINER=xenibase-dev-agent-test-2-1
XENIBASE_TEST_AGENT2_ADDR=127.0.0.1:7072
XENIBASE_TEST_AGENT3_CONTAINER=xenibase-dev-agent-test-3-1
XENIBASE_TEST_AGENT3_ADDR=127.0.0.1:7073
XENIBASE_TEST_AGENT4_CONTAINER=xenibase-dev-agent-test-4-1
XENIBASE_TEST_AGENT4_ADDR=127.0.0.1:7074
# M7: a shared cluster with a small data disk, for the disk-full test.
XENIBASE_TEST_SMALL_ADMIN_URL=postgres://xenibase_admin:xenibase_admin@127.0.0.1:5442/postgres?sslmode=disable
XENIBASE_TEST_SMALL_POOLER_HOST=shared-pg-small
XENIBASE_TEST_POOLER_TX_CONTAINER=xenibase-dev-pooler-tx-test-1
# The load test's second shared node (make test-load).
XENIBASE_TEST_LOAD2_ADMIN_URL=postgres://xenibase_admin:xenibase_admin@127.0.0.1:5443/postgres?sslmode=disable
XENIBASE_TEST_LOAD2_POOLER_HOST=shared-pg-2
# M17: the edge pooler host failover test (make pooler-host-images).
XENIBASE_TEST_POOLER_HOST_IMAGE=xenibase-pooler-host:local
XENIBASE_TEST_KEEPALIVED_IMAGE=xenibase-keepalived:local
XENIBASE_TEST_STATUS_IMAGE=xenibase-status:local
# V4-M36: a Supabase hobby project (Supabase's Postgres, GoTrue, storage-api
# with its S3 protocol) for the migration helper.
XENIBASE_TEST_SUPA_DB_URL=postgres://postgres:supabase-hobby@172.31.251.1:5452/postgres?sslmode=disable
XENIBASE_TEST_SUPA_AUTH_URL=http://172.31.251.1:5453
XENIBASE_TEST_SUPA_STORAGE_URL=http://172.31.251.1:5454
XENIBASE_TEST_SUPA_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzAwMDAwMDAwLCJleHAiOjIwMDAwMDAwMDB9.oLDe_M2CG8AR4fn8rVAlv7Bsr-8u6hn-S5BX4_xEsIU
XENIBASE_TEST_SUPA_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3MDAwMDAwMDAsImV4cCI6MjAwMDAwMDAwMH0.Eo0P_HXfmjYHj1yMLc1ZxvzEixWGXvbVzBQzUHyIXLQ
XENIBASE_TEST_SUPA_S3_KEY=xenibase-supabase-s3-key
XENIBASE_TEST_SUPA_S3_SECRET=xenibase-supabase-s3-secret-0123456789
# The integration servers listen on the Docker bridge (172.31.251.1),
# plain http://, for the containers to reach; the CLI needs the opt-in.
XENIBASE_ALLOW_HTTP=1
