# xenibase-edge (V4 §2.1). Copy to edge.env on each edge node and edit.
# xenibase-server's URL as the edge reaches it (over the mesh is best).
XENIBASE_EDGE_CONTROL_URL=https://xenibase.internal:8080
# This edge's credential, bound to its region (on the server:
#   xenibase-server -issue-edge-credential <name> -edge-region <region>).
# An edge of the platform's API domain may use xenibase-server's own
# XENIBASE_EDGE_SECRET instead.
XENIBASE_EDGE_SECRET=
# Projects are served at https://<ref>.<domain>; the same as XENIBASE_API_DOMAIN.
XENIBASE_EDGE_DOMAIN=api.xenibase.ng
# The region this edge serves (empty: every region).
XENIBASE_EDGE_REGION=ng-lagos
# A wildcard certificate for *.<domain> (renewed by your DNS-01 client; the
# edge re-reads it). Leave both empty behind a TLS terminator.
XENIBASE_EDGE_TLS_CERT=/etc/xenibase-edge/tls/fullchain.pem
XENIBASE_EDGE_TLS_KEY=/etc/xenibase-edge/tls/privkey.pem
XENIBASE_EDGE_LISTEN=:443
# Optional: the transaction pooler as this edge reaches it (host:port), and
# the proxies allowed to set X-Forwarded-For (CIDRs, comma-separated).
#XENIBASE_EDGE_POOLER_ADDR=10.0.0.2:6543
#XENIBASE_EDGE_SESSION_ADDR=10.0.0.2:5432
#XENIBASE_EDGE_TRUSTED_PROXIES=10.0.0.0/16
# Optional: the anonymous-read cache per process (MB, default 64), and each
# image render worker's memory limit (MB, default 512).
#XENIBASE_EDGE_CACHE_MB=64
#XENIBASE_EDGE_RENDER_MEMORY_MB=512
